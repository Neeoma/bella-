# Copy to .env (or set these in your host's environment) and fill in.
PORT=8000
# Public URL of the site, used for the Paystack callback. No trailing slash.
BASE_URL=http://localhost:8000
# Admin dashboard password. CHANGE THIS before going live.
ADMIN_PASSWORD=change-me-please
# Paystack secret key (dashboard.paystack.com → Settings → API Keys). Leave empty to disable online payments.
PAYSTACK_SECRET_KEY=
